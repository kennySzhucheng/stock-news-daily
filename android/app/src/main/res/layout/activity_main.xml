<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- ===== v1.1.0 顶部栏：logo + 标题 + 更新时间 + 在浏览器打开 + 刷新 =====
         外层 height=wrap_content，由 MainActivity#applyWindowInsets 把状态栏高度加成
         paddingTop；内层 titleRow 才是固定 56dp 的设计高度（带刘海机器只加 padding，
         不会把标题挤没）。 -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/brand">

        <LinearLayout
            android:id="@+id/titleRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="2dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_logo"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/on_brand"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/app_tagline"
                    android:textColor="@color/brand_muted"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnAi"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_ai"
                android:tint="@color/on_brand"
                android:scaleType="centerInside"
                android:padding="11dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_title" />

            <ImageButton
                android:id="@+id/btnBrowser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_browser"
                android:scaleType="centerInside"
                android:padding="11dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_browser" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_refresh"
                android:tint="@color/on_brand"
                android:scaleType="centerInside"
                android:padding="11dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_refresh" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 加载进度条（水平，细） ===== -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/progress"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <!-- ===== 网页容器 + 加载遮罩 + 下拉提示 ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 下拉刷新提示（拖动时出现，松手后消失） -->
        <TextView
            android:id="@+id/pullHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:elevation="6dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="@string/pull_hint"
            android:textColor="@color/brand"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 首屏加载遮罩：避免打开就只看到一片空白 -->
        <LinearLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/paper"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loadingSpinner"
                style="?android:attr/progressBarStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/state_loading"
                android:textColor="@color/tab_inactive"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ===== 底部三个入口（同样：外层 wrap_content，代码补 paddingBottom） ===== -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/tab_bar_bg">

        <LinearLayout
            android:id="@+id/tabRow"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabDaily"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iconDaily"
                    style="@style/TabIcon"
                    android:src="@drawable/ic_tab_daily"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/labelDaily"
                    style="@style/TabLabel"
                    android:text="@string/tab_daily" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabWeb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iconWeb"
                    style="@style/TabIcon"
                    android:src="@drawable/ic_tab_web"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/labelWeb"
                    style="@style/TabLabel"
                    android:text="@string/tab_web" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabReview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iconReview"
                    style="@style/TabIcon"
                    android:src="@drawable/ic_tab_review"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/labelReview"
                    style="@style/TabLabel"
                    android:text="@string/tab_review" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
